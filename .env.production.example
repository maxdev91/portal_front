# Production settings for docker-compose.prod.yml. Copy to .env.production (never commit it) and fill in the values.

# Server-side URL of the Laravel API (inside the Docker network).
API_INTERNAL_URL=http://portal_api:8080/api/v1
# Public URL of this portal (absolute links, metadata). Inlined at build time.
NEXT_PUBLIC_SITE_URL=https://portal.example.com
# Same value as FRONTEND_REVALIDATE_SECRET in portal_back/.env.production.
REVALIDATE_SECRET=
# HTTPS only session cookie.
SESSION_COOKIE_SECURE=true

# Host port of docker-compose.prod.yml (bound to 127.0.0.1, behind the reverse proxy).
WEB_PORT=3100
