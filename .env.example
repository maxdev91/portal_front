# Server-side URL of the Laravel API (inside the Docker network).
API_INTERNAL_URL=http://portal_api:8080/api/v1
# Public URL of this portal (absolute links, metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Shared secret the API sends to /api/revalidate. Must match FRONTEND_REVALIDATE_SECRET in portal_back.
REVALIDATE_SECRET=local-revalidate-secret
# true in production (HTTPS only session cookie).
SESSION_COOKIE_SECURE=false
